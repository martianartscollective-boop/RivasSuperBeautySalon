  "location": {
    "title": "Rivas Super Salon",
    "paragraphs": [
      "1407 N. Frazier St, Conroe, TX 77301 — free on-site parking right out front.",
      "Walk-ins are always welcome, and appointments get priority. Call or text ahead to check the wait."
    ],
    "mapQuery": "1407 N Frazier St, Conroe, TX 77301"
  },
  "faq": [
    {
      "q": "Do I need an appointment, or can I walk in?",
      "a": "Both work! Walk-ins are always welcome, but appointments get priority, especially on weekends. Call or text ahead if you want to check the wait."
    },
    {
      "q": "Can I pay in person instead of online?",
      "a": "Of course. You're welcome to pay in person with cash or card — booking or paying online is just an option for those who'd rather reserve ahead."
    },
    {
      "q": "I want to bring my own hair extensions — can you install them?",
      "a": "Yes! We install client-provided extensions using the wax method (lasts about 2–3 months), braided-in, or keratin bond. Just let us know your preferred method when you book, in the notes."
    },
    {
      "q": "Do you speak Spanish?",
      "a": "Sí! Our team is fully bilingual. Call or text (936) 529-6735 for Spanish, or (936) 224-9442 for English."
    }
  ],
